@page
@model LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <p>You have been logged out successfully.</p>
        <p>
            <a asp-page="/Account/Login">Click here to log in again</a>
        </p>
    </div>
</div>