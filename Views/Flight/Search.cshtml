@model dynamic
@{
    ViewData["Title"] = "Search Flights";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Book your flight with our easy-to-use flight reservation system">
    <meta name="robots" content="index, follow">
    <meta name="author" content="Flight Reservation">
    <title>Flight Reservation</title>

    <!-- External CSS Libraries -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <style>
        :root {
            --primary-color: #007bff;
            --primary-color-rgb: 0, 123, 255;
            --white: #ffffff;
            --spacing-unit: 1rem;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f5f5f5;
        }

        /* Search Container Styles */
        .search-container {
            max-width: 1450px;
            margin: calc(var(--spacing-unit)* 2) auto;
            padding: 0;
            background: var(--white);
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            min-height: 300px;
        }

        /* Search Navigation Tabs Styles */
        .search-nav-tabs {
            display: flex;
            justify-content: space-evenly;
            gap: 0.25rem;
            padding: 1rem 2rem;
            background-color: rgba(0, 0, 0, 0.0);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            position: relative;
            z-index: 0;
            border-radius: 20px 20px 0px 0px;
            overflow-x: auto;
            scrollbar-width: none; /* For Firefox */
            margin-top: -2px;
            box-shadow: none;
        }

            .search-nav-tabs::-webkit-scrollbar {
                display: none; /* For Chrome and others */
            }

        .search-nav-item {
            display: flex;
            align-items: center;
            padding: 0.75rem 1.5rem;
            color: #4a4a4a;
            font-weight: 500;
            font-size: 1rem;
            text-decoration: none;
            border-radius: 10px;
            transition: all 0.25s ease-in-out;
            white-space: nowrap;
            position: relative;
        }

            .search-nav-item:hover {
                color: var(--primary-color);
                background-color: rgba(var(--primary-color-rgb), 0.05);
            }

            .search-nav-item.active {
                color: var(--primary-color);
                font-weight: 600;
            }

                .search-nav-item.active::after {
                    content: '';
                    position: absolute;
                    bottom: -2px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 60%;
                    height: 3px;
                    background-color: var(--primary-color);
                    border-radius: 3px 3px 0 0;
                }

            .search-nav-item i {
                margin-right: 0.5rem;
                font-size: 1.2rem;
            }

        /* Background image section - fixed height without filters */
        .search-bg {
            position: absolute;
            top: 60px;
            left: 0;
            width: 100%;
            height: 250px;
            background: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1350&q=80') no-repeat center center;
            background-size: cover;
            z-index: 1;
        }

        .search-header {
            text-align: center;
            padding: calc(var(--spacing-unit)* 1.5) calc(var(--spacing-unit)* 2);
            position: relative;
            z-index: 2;
            margin-top: 0;
            margin-bottom: 20px;
        }

            .search-header h1 {
                font-size: 1.9rem;
                font-weight: 900;
                margin-bottom: 0.75rem;
                letter-spacing: -0.5px;
                text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            }

            .search-header p {
                font-size: 0.9rem;
                font-weight: 400;
                opacity: 0.8;
                letter-spacing: 0.5px;
                max-width: 800px;
                margin: 0 auto;
                text-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
            }

        /* Position search content over the image */
        .search-content {
            position: relative;
            z-index: 2;
            padding: calc(var(--spacing-unit)* 1.5) calc(var(--spacing-unit)* 2);
            background: transparent;
            border-radius: 0 0 20px 20px;
            margin-top: 0;
        }

        .search-card {
            background: rgba(255, 255, 255, 1);
            border-radius: 14px;
            padding: calc(var(--spacing-unit)* 1.25);
            animation: fadeIn 0.6s ease-out;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            margin: 0 auto;
            margin-top: 20px;
            max-width: 100%;
            border: 1px solid rgba(0, 0, 0, 0.03);
            position: relative;
            z-index: 3;
            transition: box-shadow 0.3s ease;
        }

        .search-content .tab-content {
            display: none;
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

            .search-content .tab-content.active {
                display: block;
                opacity: 1;
                transform: translateY(0);
            }

        .form-row {
            display: flex;
            align-items: flex-end;
            gap: 15px;
            flex-wrap: wrap;
        }

        .form-group {
            position: relative;
            flex: 1;
            min-width: 200px;
        }

        .form-label {
            font-size: 0.9rem;
            color: #333;
            margin-bottom: 5px;
            display: block;
            font-weight: 600;
        }

        .form-control, .form-select {
            border-radius: 5px;
            padding: 10px;
            font-size: 1rem;
            border: 1px solid #ddd;
            width: 100%;
        }

        .input-icon {
            position: absolute;
            right: 10px;
            top: 65%;
            transform: translateY(-50%);
            color: #666;
        }

        .swap-btn {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #ddd !important;
            background-color: white !important;
            border-radius: 50% !important;
            cursor: pointer;
        }

        .search-btn {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

            .search-btn i {
                margin-right: 8px;
            }

            .search-btn:hover {
                background-color: #0056b3;
            }

        .text-danger {
            color: #dc3545;
            font-size: 0.8rem;
            margin-top: 5px;
            display: block;
        }

        
    </style>
</head>
<body>

    <!-- Main Content -->
    <div class="container">
        <!-- Search Header -->
        <div class="search-header">
            <h1>Book Your Flight</h1>
            <p>Experience world-class service and comfort</p>
        </div>

        <!-- Search Container -->
        <div class="search-container">
            <div class="search-bg"></div>
            <div class="search-nav-tabs">
                <a href="#" class="search-nav-item active" data-tab="book-flight">
                    <i class="fas fa-plane"></i> Book a Flight
                </a>
                <a href="#" class="search-nav-item" data-tab="check-in">
                    <i class="far fa-calendar-alt"></i> Check In
                </a>
                <a href="#" class="search-nav-item" data-tab="manage-bookings">
                    <i class="fas fa-map-marker-alt"></i> Manage Bookings
                </a>
                <a href="#" class="search-nav-item" data-tab="flight-status">
                    <i class="fas fa-info-circle"></i> Flight Status
                </a>
            </div>

            <div class="search-content">
                <!-- Book a Flight Form -->
                <div class="search-card tab-content active" id="book-flight">
                    <form asp-action="Search" method="post">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">From</label>
                                <select name="departureAirportId" id="departureAirportId" class="form-select" required>
                                    <option value="">Select Departure Airport</option>
                                    @foreach (var airport in ViewBag.Airports)
                                    {
                                        <option value="@airport.AirportId">@airport.Name (@airport.Code)</option>
                                    }
                                </select>
                            </div>

                            <div class="col-auto d-flex align-items-center justify-content-center">
                                <button type="button" class="swap-btn btn btn-outline-secondary" aria-label="Swap departure and destination" title="Swap departure and destination">
                                    <i class="fas fa-exchange-alt"></i>
                                </button>
                            </div>

                            <div class="form-group">
                                <label class="form-label">To</label>
                                <select name="arrivalAirportId" id="arrivalAirportId" class="form-select" required>
                                    <option value="">Select Arrival Airport</option>
                                    @foreach (var airport in ViewBag.Airports)
                                    {
                                        <option value="@airport.AirportId">@airport.Name (@airport.Code)</option>
                                    }
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Departure</label>
                                <input type="date" name="date" id="date" class="form-control" />
                                <i class="far fa-calendar-alt input-icon"></i>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Return</label>
                                <input type="date" name="returnDate" id="returnDate" class="form-control" placeholder="Return date" />
                                <i class="far fa-calendar-alt input-icon"></i>
                            </div>

                            <div class="col-auto">
                                <button type="submit" class="search-btn">
                                    <i class="fas fa-search me-2"></i> Find Flights
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Check In Form (Placeholder) -->
                <div class="search-card tab-content" id="check-in">
                    <form id="checkInForm" method="post" novalidate>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="bookingReference" class="form-label">Booking Reference</label>
                                <input type="text" class="form-control" id="bookingReference" name="bookingReference" placeholder="Enter your booking reference" required>
                            </div>
                            <div class="form-group">
                                <label for="lastName" class="form-label">Last Name</label>
                                <input type="text" class="form-control" id="lastName" name="lastName" placeholder="Enter your last name" required>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="search-btn">
                                    <i class="fas fa-check me-2"></i> Check In
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Flight Status Form (Placeholder) -->
                <div class="search-card tab-content" id="flight-status">
                    <form id="flightStatusForm" method="get" novalidate>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="flightNumber" class="form-label">Flight Number</label>
                                <input type="text" class="form-control" id="flightNumber" name="flightNumber" placeholder="e.g., AA123" required>
                            </div>
                            <div class="form-group">
                                <label for="flightDate" class="form-label">Date</label>
                                <input type="date" class="form-control" id="flightDate" name="flightDate" required>
                                <i class="far fa-calendar-alt input-icon"></i>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="search-btn">
                                    <i class="fas fa-info-circle me-2"></i> Check Status
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- External JS Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Tab switching
            const tabs = document.querySelectorAll('.search-nav-item');
            const tabContents = document.querySelectorAll('.tab-content');

            tabs.forEach(tab => {
                tab.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetTab = this.getAttribute('data-tab');

                    // Remove active class from all tabs and contents
                    tabs.forEach(t => t.classList.remove('active'));
                    tabContents.forEach(content => content.classList.remove('active'));

                    // Add active class to clicked tab and corresponding content
                    this.classList.add('active');
                    document.getElementById(targetTab).classList.add('active');
                });
            });

            // Swap button functionality
            const swapBtn = document.querySelector('.swap-btn');
            if (swapBtn) {
                swapBtn.addEventListener('click', function () {
                    const departureSelect = document.getElementById('departureAirportId');
                    const arrivalSelect = document.getElementById('arrivalAirportId');
                    const tempValue = departureSelect.value;
                    const tempText = departureSelect.options[departureSelect.selectedIndex].text;
                    
                    departureSelect.value = arrivalSelect.value;
                    arrivalSelect.value = tempValue;
                    
                    // Update the displayed text
                    if (departureSelect.options[departureSelect.selectedIndex]) {
                        departureSelect.options[departureSelect.selectedIndex].selected = true;
                    }
                    if (arrivalSelect.options[arrivalSelect.selectedIndex]) {
                        arrivalSelect.options[arrivalSelect.selectedIndex].selected = true;
                    }
                });
            }

            // Initialize Flatpickr for date pickers
            flatpickr("#date", {
                dateFormat: "Y-m-d",
                minDate: "today"
            });

            flatpickr("#returnDate", {
                dateFormat: "Y-m-d",
                minDate: "today"
            });

            flatpickr("#flightDate", {
                dateFormat: "Y-m-d",
                minDate: "today"
            });

            // Update ReturnDate's minDate when DepartureDate changes
            const departureDateInput = document.getElementById("date");
            const returnDateInput = document.getElementById("returnDate");

            if (departureDateInput && returnDateInput) {
                departureDateInput.addEventListener('change', function() {
                    if (this.value) {
                        returnDateInput._flatpickr.set('minDate', this.value);
                    }
                });
            }
        });
    </script>
</body>
</html>