@model FlightReservationSystem.DTOs.FlightSearchViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flight Search Results</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <style>
        /* Keep all your existing styles from the previous example */
        /* Add this additional style for the flight cards */
        .flight-card {
            border-left: 4px solid #003580;
        }

        .flight-number {
            font-size: 14px;
            color: #666;
        }
    </style>
</head>
<body>
    <div class="container-fluid search-header">
        <div class="container">
            <h1>Flights from @Model.DepartureAirport to @Model.ArrivalAirport</h1>
            <div class="subtitle">
                @Model.AvailableFlights.Count flights • @Model.DepartureDate.ToString("dd MMM yyyy") •
                @(Model.ReturnDate.HasValue ? "Round-trip" : "One-way") • 1 Traveller
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <!-- Filters Column -->
            <div class="col-md-3">
                <div class="filter-section">
                    <h3>Fare Type</h3>
                    <div class="filter-option">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="refundable">
                            <label class="form-check-label" for="refundable">Refundable</label>
                        </div>
                    </div>
                    <div class="filter-option">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="nonRefundable" checked>
                            <label class="form-check-label" for="nonRefundable">Non-Refundable</label>
                        </div>
                    </div>
                </div>

                <div class="filter-section">
                    <h3>Airlines</h3>
                    @foreach (var airline in Model.AvailableFlights.Select(f => f.AirlineName).Distinct())
                    {
                        <div class="filter-option">
                            <div class="form-check">
                                <input class="form-check-input airline-filter" type="checkbox"
                                       id="airline-@airline.Replace(" ", "-")" checked
                                       data-airline="@airline">
                                <label class="form-check-label" for="airline-@airline.Replace(" ", "-")">@airline</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Results Column -->
            <div class="col-md-9">
                @if (Model.AvailableFlights.Any())
                {
                    foreach (var flight in Model.AvailableFlights)
                    {
                        <div class="flight-card mb-4 p-4" data-airline="@flight.AirlineName">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <div class="d-flex align-items-center">
                                        <img src="@flight.AirlineLogoUrl" alt="@flight.AirlineName" class="airline-logo me-2">
                                        <div>
                                            <h5 class="mb-0">@flight.AirlineName</h5>
                                            <span class="flight-number">@flight.FlightNumber</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <h4 class="text-primary mb-0">$@flight.BasePrice.ToString("N0")</h4>
                                    <small class="text-muted">price per person (incl. taxes)</small>
                                </div>
                            </div>

                            <div class="row align-items-center">
                                <div class="col-md-4">
                                    <div class="text-center">
                                        <div class="time">@flight.DepartureTime.ToString("h:mm tt")</div>
                                        <div class="city">@flight.DepartureAirport</div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="text-center">
                                        <div class="duration">
                                            @flight.Duration h
                                        </div>
                                        <div class="stops-info">
                                            @if (flight.Stops > 0)
                                            {
                                                <span>@flight.Stops @(flight.Stops == 1 ? "stop" : "stops")</span>
                                            }
                                            else
                                            {
                                                <span>Non-stop</span>
                                            }
                                        </div>
                                        <div class="duration-line my-2"></div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="text-center">
                                        <div class="time">@flight.ArrivalTime.ToString("h:mm tt")</div>
                                        <div class="city">@flight.ArrivalAirport</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <a href="#" class="text-primary view-details">
                                    <i class="fas fa-chevron-down me-1"></i> View Flight Details
                                </a>
                                <a asp-action="Book" asp-route-id="@flight.FlightId" class="btn btn-primary book-btn">
                                    Book Now
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        No flights found matching your criteria. Please try different search parameters.
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Filter functionality
        document.querySelectorAll('.airline-filter').forEach(filter => {
            filter.addEventListener('change', function () {
                const airline = this.dataset.airline;
                const isChecked = this.checked;

                document.querySelectorAll('.flight-card').forEach(card => {
                    if (card.dataset.airline === airline) {
                        card.style.display = isChecked ? 'block' : 'none';
                    }
                });
            });
        });

        // View details toggle
        document.querySelectorAll('.view-details').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                // Implement details expansion here
                alert('Flight details would be displayed here');
            });
        });
    </script>
</body>
</html>