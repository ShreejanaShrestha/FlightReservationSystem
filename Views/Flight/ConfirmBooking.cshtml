@model dynamic

@{
    ViewData["Title"] = "Confirm Booking";
}

<h2>Confirm Your Booking</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>Are you sure you want to proceed with this booking? You will be redirected to the payment page (simulated for now).</p>

<div class="mt-3">
    <a asp-action="ProcessBooking" class="btn btn-primary">Confirm and Proceed</a>
    <a asp-action="AddPassengerDetails" class="btn btn-secondary">Back to Passenger Details</a>
</div>