@* FlightReservationSystem/Views/Admin/Index.cshtml *@
@model FlightReservationSystem.Models.AdminPanelViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<style>
    .modal-body .form-group {
        margin-bottom: 15px;
    }

    .modal-body .text-danger {
        display: block;
        font-size: 0.875em;
        color: #dc3545;
    }

    .section {
        margin-bottom: 30px;
    }
</style>

<h1>Admin Panel</h1>

<p>Welcome to the Admin Panel. Here you can manage flights, airports, airlines, bookings, and users.</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}



<!-- Flights Section -->
<div class="section">
    <h2>Flights</h2>
    <p><a href="#" onclick="showCreateFlightForm()" class="btn btn-primary">Create New Flight</a></p>
    <div id="flightsTable">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Flight Number</th>
                    <th>Airline</th>
                    <th>Departure Airport</th>
                    <th>Arrival Airport</th>
                    <th>Departure Time</th>
                    <th>Arrival Time</th>
                    <th>Base Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="flightsBody">
                @foreach (var flight in Model.Flights)
                {
                    <tr>
                        <td>@flight.FlightNumber</td>
                        <td>@flight.Airline.Name</td>
                        <td>@flight.DepartureAirport.Name (@flight.DepartureAirport.Code)</td>
                        <td>@flight.ArrivalAirport.Name (@flight.ArrivalAirport.Code)</td>
                        <td>@flight.DepartureTime.ToString("g")</td>
                        <td>@flight.ArrivalTime.ToString("g")</td>
                        <td>$@flight.BasePrice</td>
                        <td>
                            <a href="#" onclick="showEditFlightForm(@flight.FlightId)" class="btn btn-sm btn-warning">Edit</a>
                            <a href="#" onclick="deleteFlight(@flight.FlightId)" class="btn btn-sm btn-danger">Delete</a>
                            <a href="#" onclick="viewFlightBookings(@flight.FlightId)" class="btn btn-sm btn-info">View Bookings</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Airports Section -->
<div class="section">
    <h2>Airports</h2>
    <p><a href="#" onclick="showCreateAirportForm()" class="btn btn-primary">Create New Airport</a></p>
    <div id="airportsTable">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>City</th>
                    <th>Country</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="airportsBody">
                @foreach (var airport in Model.Airports)
                {
                    <tr>
                        <td>@airport.Name</td>
                        <td>@airport.Code</td>
                        <td>@airport.City</td>
                        <td>@airport.Country</td>
                        <td>
                            <a href="#" onclick="showEditAirportForm(@airport.AirportId)" class="btn btn-sm btn-warning">Edit</a>
                            <a href="#" onclick="deleteAirport(@airport.AirportId)" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Airlines Section -->
<div class="section">
    <h2>Airlines</h2>
    <p><a href="#" onclick="showCreateAirlineForm()" class="btn btn-primary">Create New Airline</a></p>
    <div id="airlinesTable">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="airlinesBody">
                @foreach (var airline in Model.Airlines)
                {
                    <tr>
                        <td>@airline.Name</td>
                        <td>@airline.Code</td>
                        <td>
                            <a href="#" onclick="showEditAirlineForm(@airline.AirlineId)" class="btn btn-sm btn-warning">Edit</a>
                            <a href="#" onclick="deleteAirline(@airline.AirlineId)" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Bookings Section -->
<div class="section">
    <h2>Bookings</h2>
    <div id="bookingsTable">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Flight Number</th>
                    <th>User ID</th>
                    <th>Booking Date</th>
                    <th>Status</th>
                    <th>Passengers</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="bookingsBody">
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.BookingId</td>
                        <td>@booking.Flight.FlightNumber</td>
                        <td>@booking.UserId</td>
                        <td>@booking.BookingDate.ToString("g")</td>
                        <td>@booking.Status</td>
                        <td>@booking.Passengers.Count</td>
                        <td>
                            <a href="#" onclick="viewBookingDetails(@booking.BookingId)" class="btn btn-sm btn-info">View Details</a>
                            @if (booking.Status != "Cancelled")
                            {
                                <a href="#" onclick="cancelBooking(@booking.BookingId)" class="btn btn-sm btn-danger">Cancel</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<!-- Reset Database Button -->
<div class="mb-4">
    <form asp-action="ResetDatabase" method="post" onsubmit="return confirm('Are you sure you want to reset the database? This will delete all data and create default entries.');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Reset Database</button>
    </form>
</div>

@* <!-- Users Section -->
<div class="section">
    <h2>Users</h2>
    <div id="usersTable">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Roles</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="usersBody">
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.FirstName</td>
                        <td>@user.LastName</td>
                        <td>
                            @(await UserManager.GetRolesAsync(user))
                        </td>
                        <td>
                            <a href="#" onclick="manageUserRoles('@user.Id')" class="btn btn-sm btn-warning">Manage Roles</a>
                            <a href="#" onclick="deleteUser('@user.Id')" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
