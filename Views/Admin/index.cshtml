        function cancelBooking(bookingId) {
            event.preventDefault(); // Prevent default behavior of the <a> tag

            if (confirm('Are you sure you want to cancel this booking?')) {
                fetch(`/api/bookings/${bookingId}/cancel`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.getElementById('RequestVerificationToken').value
                    },
                    credentials: 'include'
                })
                    .then(response => {
                        if (!response.ok) {
                            return response.json().then(error => {
                                throw new Error(error.error || error.message || `HTTP error! Status: ${response.status}`);
                            });
                        }
                        return response;
                    })
                    .then(() => {
                        alert('Booking cancelled successfully.');
                        loadBookings(); // Refresh the bookings table
                    })
                    .catch(error => {
                        console.error('Error in cancelBooking:', error);
                        alert(`Error cancelling booking: ${error.message}`);
                    });
            }
        }

        // Functions for Users
        function manageUserRoles(userId) {
            fetch(`/api/users/${userId}/roles`)
                .then(response => response.json())
                .then(roles => {
                    $('#crudModalLabel').text('Manage User Roles');
                    $('#crudModalBody').html(`
                                <form id="userRolesForm">
                                    <div class="form-group">
                                        <label>Roles</label>
                                        <div class="form-check">
                                            <input type="checkbox" id="adminRole" class="form-check-input" ${roles.includes('Admin') ? 'checked' : ''}>
                                            <label class="form-check-label" for="adminRole">Admin</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" id="userRole" class="form-check-input" ${roles.includes('User') ? 'checked' : ''}>
                                            <label class="form-check-label" for="userRole">User</label>
                                        </div>
                                    </div>
                                </form>
                            `);
                    $('#saveButton').show().off('click').on('click', function () {
                        const updatedRoles = [];
                        if ($('#adminRole').is(':checked')) updatedRoles.push('Admin');
                        if ($('#userRole').is(':checked')) updatedRoles.push('User');
                        fetch(`/api/users/${userId}/roles`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(updatedRoles)
                        })
                            .then(response => {
                                if (response.ok) {
                                    $('#crudModal').modal('hide');
                                    loadUsers();
                                } else {
                                    response.text().then(error => {
                                        $('#crudModalBody').prepend(`<div class="alert alert-danger">${error}</div>`);
                                    });
                                }
                            })
                            .catch(error => {
                                $('#crudModalBody').prepend(`<div class="alert alert-danger">Error updating user roles: ${error.message}</div>`);
                            });
                    });
                    const bootstrapModal = new bootstrap.Modal(document.getElementById('crudModal'));
                    bootstrapModal.show();
                });
        }

