</div>*@

<!-- Modal for Create/Edit Forms -->
<div class="modal fade" id="crudModal" tabindex="-1" role="dialog" aria-labelledby="crudModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crudModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="crudModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="saveButton">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            loadFlights();
            loadAirports();
            loadAirlines();
            loadBookings();
            loadUsers();
        });

        // Load Flights
        function loadFlights() {
            fetch('/api/flights')
                .then(response => response.json())
                .then(data => {
                    const tbody = $('#flightsBody');
                    tbody.empty();
                    if (data && data.length > 0) {
                        data.forEach(flight => {
                            tbody.append(`
                                        <tr>
                                            <td>${flight.flightNumber}</td>
                                            <td>${flight.airlineName}</td>
                                            <td>${flight.departureAirportName} (${flight.departureAirportCode || ''})</td>
                                            <td>${flight.arrivalAirportName} (${flight.arrivalAirportCode || ''})</td>
                                            <td>${new Date(flight.departureTime).toLocaleString()}</td>
                                            <td>${new Date(flight.arrivalTime).toLocaleString()}</td>
                                            <td>$${flight.basePrice}</td>
                                            <td>
                                                <a href="#" onclick="showEditFlightForm(${flight.flightId})" class="btn btn-sm btn-warning">Edit</a>
                                                <a href="#" onclick="deleteFlight(${flight.flightId})" class="btn btn-sm btn-danger">Delete</a>
                                                <a href="#" onclick="viewFlightBookings(${flight.flightId})" class="btn btn-sm btn-info">View Bookings</a>
                                            </td>
                                        </tr>
                                    `);
                        });
                    } else {
                        tbody.append('<tr><td colspan="8">No flights available.</td></tr>');
                    }
                })
                .catch(error => console.error('Error loading flights:', error));
        }

        // Load Airports
        function loadAirports() {
            fetch('/api/airports')
                .then(response => response.json())
                .then(data => {
                    const tbody = $('#airportsBody');
                    tbody.empty();
                    if (data && data.length > 0) {
                        data.forEach(airport => {
                            tbody.append(`
                                        <tr>
                                            <td>${airport.name}</td>
                                            <td>${airport.code}</td>
                                            <td>${airport.city}</td>
                                            <td>${airport.country}</td>
                                            <td>
                                                <a href="#" onclick="showEditAirportForm(${airport.airportId})" class="btn btn-sm btn-warning">Edit</a>
                                                <a href="#" onclick="deleteAirport(${airport.airportId})" class="btn btn-sm btn-danger">Delete</a>
                                            </td>
                                        </tr>
                                    `);
                        });
                    } else {
                        tbody.append('<tr><td colspan="5">No airports available.</td></tr>');
                    }
                })
                .catch(error => console.error('Error loading airports:', error));
        }

        // Load Airlines
        function loadAirlines() {
            fetch('/api/airlines')
                .then(response => response.json())
                .then(data => {
                    const tbody = $('#airlinesBody');
                    tbody.empty();
                    if (data && data.length > 0) {
                        data.forEach(airline => {
                            tbody.append(`
                                        <tr>
                                            <td>${airline.name}</td>
                                            <td>${airline.code}</td>
                                            <td>
                                                <a href="#" onclick="showEditAirlineForm(${airline.airlineId})" class="btn btn-sm btn-warning">Edit</a>
                                                <a href="#" onclick="deleteAirline(${airline.airlineId})" class="btn btn-sm btn-danger">Delete</a>
                                            </td>
                                        </tr>
                                    `);
                        });
                    } else {
                        tbody.append('<tr><td colspan="3">No airlines available.</td></tr>');
                    }
                })
                .catch(error => console.error('Error loading airlines:', error));
        }

        // Load Bookings
        function loadBookings() {
            fetch('/api/bookings', {
                credentials: 'include'
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! Status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    const tbody = $('#bookingsBody');
                    tbody.empty();
                    if (data && data.length > 0) {
                        data.forEach(booking => {
                            fetch(`/api/flights/${booking.flightId}`, {
                                credentials: 'include'
                            })
                                .then(response => {
                                    if (!response.ok) {
                                        throw new Error(`HTTP error! Status: ${response.status}`);
                                    }
                                    return response.json();
                                })
                                .then(flight => {
                                    tbody.append(`
                                        <tr>
                                            <td>${booking.bookingId}</td>
                                            <td>${flight.flightNumber || 'N/A'}</td>
                                            <td>${booking.userId}</td>
                                            <td>${new Date(booking.bookingDate).toLocaleString()}</td>
                                            <td>${booking.status}</td>
                                            <td>${booking.passengers.length}</td>
                                            <td>
                                                <a href="#" onclick="viewBookingDetails(${booking.bookingId})" class="btn btn-sm btn-info">View Details</a>
                                                ${booking.status !== 'Cancelled' ? `<a href="#" onclick="cancelBooking(${booking.bookingId})" class="btn btn-sm btn-danger">Cancel</a>` : ''}
                                            </td>
                                        </tr>
                                    `);
                                })
                                .catch(error => {
                                    console.error(`Error loading flight for booking ${booking.bookingId}:`, error);
                                    tbody.append(`
                                        <tr>
                                            <td>${booking.bookingId}</td>
                                            <td>N/A (Flight not found)</td>
                                            <td>${booking.userId}</td>
                                            <td>${new Date(booking.bookingDate).toLocaleString()}</td>
                                            <td>${booking.status}</td>
                                            <td>${booking.passengers.length}</td>
                                            <td>
                                                <a href="#" onclick="viewBookingDetails(${booking.bookingId})" class="btn btn-sm btn-info">View Details</a>
                                                ${booking.status !== 'Cancelled' ? `<a href="#" onclick="cancelBooking(${booking.bookingId})" class="btn btn-sm btn-danger">Cancel</a>` : ''}
                                            </td>
                                        </tr>
                                    `);
                                });
                        });
                    } else {
                        tbody.append('<tr><td colspan="7">No bookings available.</td></tr>');
                    }
                })
                .catch(error => {
                    console.error('Error loading bookings:', error);
                    $('#bookingsBody').html(`<tr><td colspan="7">Error loading bookings: ${error.message}</td></tr>`);
                });
        }

        // Load Users
        function loadUsers() {
            fetch('/api/users')
                .then(response => response.json())
                .then(data => {
                    const tbody = $('#usersBody');
                    tbody.empty();
                    if (data && data.length > 0) {
                        data.forEach(user => {
                            fetch(`/api/users/${user.id}/roles`)
                                .then(response => response.json())
                                .then(roles => {
                                    tbody.append(`
                                                <tr>
                                                    <td>${user.email}</td>
                                                    <td>${user.firstName || 'N/A'}</td>
                                                    <td>${user.lastName || 'N/A'}</td>
                                                    <td>${roles.join(', ') || 'None'}</td>
                                                    <td>
                                                        <a href="#" onclick="manageUserRoles('${user.id}')" class="btn btn-sm btn-warning">Manage Roles</a>
                                                        <a href="#" onclick="deleteUser('${user.id}')" class="btn btn-sm btn-danger">Delete</a>
                                                    </td>
                                                </tr>
                                            `);
                                });
                        });
                    } else {
                        tbody.append('<tr><td colspan="5">No users available.</td></tr>');
                    }
                })
                .catch(error => console.error('Error loading users:', error));
        }

        // CRUD Functions for Flights
        function showCreateFlightForm() {
            fetch('/api/airlines')
                .then(response => response.json())
                .then(airlines => {
                    fetch('/api/airports')
                        .then(response => response.json())
                        .then(airports => {
                            $('#crudModalLabel').text('Create Flight');
                            $('#crudModalBody').html(`
                                        <form id="flightForm">
                                            <div class="form-group">
                                                <label>Flight Number</label>
                                                <input type="text" id="flightNumber" class="form-control" required>
                                                <span class="text-danger" id="flightNumberError"></span>
                                            </div>
                                            <div class="form-group">
                                                <label>Airline</label>
                                                <select id="airlineId" class="form-control" required>
                                                    <option value="">Select Airline</option>
                                                    ${airlines.map(a => `<option value="${a.airlineId}">${a.name}</option>`).join('')}
                                                </select>
                                                <span class="text-danger" id="airlineIdError"></span>
                                            </div>
                                            <div class="form-group">
                                                <label>Departure Airport</label>
                                                <select id="departureAirportId" class="form-control" required>
                                                    <option value="">Select Airport</option>
                                                    ${airports.map(a => `<option value="${a.airportId}">${a.name}</option>`).join('')}
                                                </select>
                                                <span class="text-danger" id="departureAirportIdError"></span>
                                            </div>
                                            <div class="form-group">
                                                <label>Arrival Airport</label>
                                                <select id="arrivalAirportId" class="form-control" required>
                                                    <option value="">Select Airport</option>
                                                    ${airports.map(a => `<option value="${a.airportId}">${a.name}</option>`).join('')}
                                                </select>
                                                <span class="text-danger" id="arrivalAirportIdError"></span>
                                            </div>
                                            <div class="form-group">
                                                <label>Departure Time</label>
                                                <input type="datetime-local" id="departureTime" class="form-control" required>
                                                <span class="text-danger" id="departureTimeError"></span>
                                            </div>
                                            <div class="form-group">
                                                <label>Arrival Time</label>
                                                <input type="datetime-local" id="arrivalTime" class="form-control" required>
                                                <span class="text-danger" id="arrivalTimeError"></span>
                                            </div>
                                            <div class="form-group">
                                                <label>Base Price</label>
                                                <input type="number" step="0.01" id="basePrice" class="form-control" required>
                                                <span class="text-danger" id="basePriceError"></span>
                                            </div>
                                        </form>
                                    `);
                            $('#saveButton').off('click').on('click', function () {
                                const form = document.getElementById('flightForm');
                                if (form.checkValidity()) {
                                    const flight = {
                                        flightNumber: $('#flightNumber').val(),
                                        airlineId: parseInt($('#airlineId').val()),
                                        departureAirportId: parseInt($('#departureAirportId').val()),
                                        arrivalAirportId: parseInt($('#arrivalAirportId').val()),
                                        departureTime: $('#departureTime').val(),
                                        arrivalTime: $('#arrivalTime').val(),
                                        basePrice: parseFloat($('#basePrice').val())
                                    };
                                    fetch('/api/flights', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify(flight)
                                    })
                                        .then(response => {
                                            if (response.ok) {
                                                $('#crudModal').modal('hide');
                                                loadFlights();
                                            } else {
                                                response.text().then(error => {
                                                    $('#crudModalBody').prepend(`<div class="alert alert-danger">${error}</div>`);
                                                });
                                            }
                                        })
                                        .catch(error => {
                                            $('#crudModalBody').prepend(`<div class="alert alert-danger">Error creating flight: ${error.message}</div>`);
                                        });
                                } else {
                                    form.reportValidity();
                                }
                            });
                            const bootstrapModal = new bootstrap.Modal(document.getElementById('crudModal'));
                            bootstrapModal.show();
                        });
                });
        }

        function showEditFlightForm(id) {
            fetch(`/api/flights/${id}`)
                .then(response => response.json())
                .then(flight => {
                    fetch('/api/airlines')
                        .then(response => response.json())
                        .then(airlines => {
                            fetch('/api/airports')
                                .then(response => response.json())
                                .then(airports => {
                                    $('#crudModalLabel').text('Edit Flight');
                                    $('#crudModalBody').html(`
                                                <form id="flightForm">
                                                    <div class="form-group">
                                                        <label>Flight Number</label>
                                                        <input type="text" id="flightNumber" class="form-control" value="${flight.flightNumber}" required>
                                                        <span class="text-danger" id="flightNumberError"></span>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Airline</label>
                                                        <select id="airlineId" class="form-control" required>
                                                            <option value="">Select Airline</option>
                                                            ${airlines.map(a => `<option value="${a.airlineId}" ${a.airlineId == flight.airlineId ? 'selected' : ''}>${a.name}</option>`).join('')}
                                                        </select>
                                                        <span class="text-danger" id="airlineIdError"></span>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Departure Airport</label>
                                                        <select id="departureAirportId" class="form-control" required>
                                                            <option value="">Select Airport</option>
                                                            ${airports.map(a => `<option value="${a.airportId}" ${a.airportId == flight.departureAirportId ? 'selected' : ''}>${a.name}</option>`).join('')}
                                                        </select>
                                                        <span class="text-danger" id="departureAirportIdError"></span>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Arrival Airport</label>
                                                        <select id="arrivalAirportId" class="form-control" required>
                                                            <option value="">Select Airport</option>
                                                            ${airports.map(a => `<option value="${a.airportId}" ${a.airportId == flight.arrivalAirportId ? 'selected' : ''}>${a.name}</option>`).join('')}
                                                        </select>
                                                        <span class="text-danger" id="arrivalAirportIdError"></span>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Departure Time</label>
                                                        <input type="datetime-local" id="departureTime" class="form-control" value="${new Date(flight.departureTime).toISOString().slice(0, 16)}" required>
                                                        <span class="text-danger" id="departureTimeError"></span>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Arrival Time</label>
                                                        <input type="datetime-local" id="arrivalTime" class="form-control" value="${new Date(flight.arrivalTime).toISOString().slice(0, 16)}" required>
                                                        <span class="text-danger" id="arrivalTimeError"></span>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Base Price</label>
                                                        <input type="number" step="0.01" id="basePrice" class="form-control" value="${flight.basePrice}" required>
                                                        <span class="text-danger" id="basePriceError"></span>
                                                    </div>
                                                </form>
                                            `);
                                    $('#saveButton').off('click').on('click', function () {
                                        const form = document.getElementById('flightForm');
                                        if (form.checkValidity()) {
                                            const updatedFlight = {
                                                flightNumber: $('#flightNumber').val(),
                                                airlineId: parseInt($('#airlineId').val()),
                                                departureAirportId: parseInt($('#departureAirportId').val()),
                                                arrivalAirportId: parseInt($('#arrivalAirportId').val()),
                                                departureTime: $('#departureTime').val(),
                                                arrivalTime: $('#arrivalTime').val(),
                                                basePrice: parseFloat($('#basePrice').val())
                                            };
                                            fetch(`/api/flights/${id}`, {
                                                method: 'PUT',
                                                headers: { 'Content-Type': 'application/json' },
                                                body: JSON.stringify(updatedFlight)
                                            })
                                                .then(response => {
                                                    if (response.ok) {
                                                        $('#crudModal').modal('hide');
                                                        loadFlights();
                                                    } else {
                                                        response.text().then(error => {
                                                            $('#crudModalBody').prepend(`<div class="alert alert-danger">${error}</div>`);
                                                        });
                                                    }
                                                })
                                                .catch(error => {
                                                    $('#crudModalBody').prepend(`<div class="alert alert-danger">Error updating flight: ${error.message}</div>`);
                                                });
                                        } else {
                                            form.reportValidity();
                                        }
                                    });
                                    const bootstrapModal = new bootstrap.Modal(document.getElementById('crudModal'));
                                    bootstrapModal.show();
                                });
                        });
                });
        }

        function deleteFlight(id) {
            if (confirm('Are you sure you want to delete this flight?')) {
                fetch(`/api/flights/${id}`, {
                    method: 'DELETE'
                })
                    .then(response => {
                        if (response.ok) {
                            loadFlights();
                        } else {
                            response.text().then(error => {
                                alert(`Error deleting flight: ${error}`);
                            });
                        }
