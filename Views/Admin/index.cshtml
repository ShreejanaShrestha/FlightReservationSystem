        function viewFlightBookings(flightId) {
            event.preventDefault(); // Prevent default behavior of the <a> tag

            fetch(`/api/flights/${flightId}/bookings`, {
                method: 'GET',
                headers: {
                    'RequestVerificationToken': document.getElementById('RequestVerificationToken')?.value || ''
                },
                credentials: 'include'
            })
                .then(response => {
                    if (!response.ok) {
                        return response.text().then(text => {
                            throw new Error(text || `HTTP error! Status: ${response.status}`);
                        });
                    }
                    return response.json();
                })
                .then(data => {
                    $('#crudModalLabel').text(`Bookings for Flight ${data.flight.flightNumber}`);

                    // Flight Details Section
                    let flightDetailsHtml = '<h3>Flight Details</h3>';
                    flightDetailsHtml += `
                        <dl class="row">
                            <dt class="col-sm-3">Flight Number</dt>
                            <dd class="col-sm-9">${data.flight.flightNumber}</dd>
                            <dt class="col-sm-3">Airline</dt>
                            <dd class="col-sm-9">${data.flight.airlineName}</dd>
                            <dt class="col-sm-3">Departure Airport</dt>
                            <dd class="col-sm-9">${data.flight.departureAirportName}</dd>
                            <dt class="col-sm-3">Arrival Airport</dt>
                            <dd class="col-sm-9">${data.flight.arrivalAirportName}</dd>
                            <dt class="col-sm-3">Departure Time</dt>
                            <dd class="col-sm-9">${new Date(data.flight.departureTime).toLocaleString()}</dd>
                            <dt class="col-sm-3">Arrival Time</dt>
                            <dd class="col-sm-9">${new Date(data.flight.arrivalTime).toLocaleString()}</dd>
                            <dt class="col-sm-3">Base Price</dt>
                            <dd class="col-sm-9">$${data.flight.basePrice}</dd>
                        </dl>
                    `;

                    // Bookings Section
                    let bookingsHtml = '<h3>Bookings</h3>';
                    if (data.bookings && data.bookings.length > 0) {
                        bookingsHtml += `
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Booking ID</th>
                                        <th>User ID</th>
                                        <th>Booking Date</th>
                                        <th>Status</th>
                                        <th>Passengers</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${data.bookings.map(b => `
                                        <tr>
                                            <td>${b.bookingId}</td>
                                            <td>${b.userId}</td>
                                            <td>${new Date(b.bookingDate).toLocaleString()}</td>
                                            <td>${b.status}</td>
                                            <td>${b.passengers.length}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        `;
                    } else {
                        bookingsHtml += '<p>No bookings for this flight.</p>';
                    }

                    // Passengers Section
                    let passengersHtml = '<h3>Passengers</h3>';
                    if (data.passengers && data.passengers.length > 0) {
                        passengersHtml += `
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Passenger ID</th>
                                        <th>Full Name</th>
                                        <th>Passport Number</th>
                                        <th>Seat Number</th>
                                        <th>Booking ID</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${data.passengers.map(p => `
                                        <tr>
                                            <td>${p.passengerId}</td>
                                            <td>${p.fullName}</td>
                                            <td>${p.passportNumber || 'N/A'}</td>
                                            <td>${p.seatNumber}</td>
                                            <td>${p.bookingId}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        `;
                    } else {
                        passengersHtml += '<p>No passengers for this flight.</p>';
                    }

                    $('#crudModalBody').html(flightDetailsHtml + bookingsHtml + passengersHtml);
                    $('#saveButton').hide();
                    const bootstrapModal = new bootstrap.Modal(document.getElementById('crudModal'));
                    bootstrapModal.show();
                })
                .catch(error => {
                    console.error('Error in viewFlightBookings:', error);
                    $('#crudModalLabel').text('Error');
                    $('#crudModalBody').html(`<div class="alert alert-danger">Error loading bookings: ${error.message}</div>`);
                    $('#saveButton').hide();
                    const bootstrapModal = new bootstrap.Modal(document.getElementById('crudModal'));
                    bootstrapModal.show();
                });
        }

