@model FlightReservationSystem.DTO.FlightStatusDto

@{
    ViewData["Title"] = "Flight Status Details";
}

<h2>Flight Status</h2>

<div class="mb-4">
    <p><strong>PNR:</strong> @Model.PNR</p>
    <p><strong>Flight:</strong> @Model.FlightNumber (@Model.Airline)</p>
    <p><strong>From:</strong> @Model.DepartureAirport</p>
    <p><strong>To:</strong> @Model.ArrivalAirport</p>
    <p><strong>Departure:</strong> @Model.DepartureTime.ToString("f")</p>
    <p><strong>Arrival:</strong> @Model.ArrivalTime.ToString("f")</p>
    <p><strong>Status:</strong> @Model.Status</p>
</div>

<h4>Passengers</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Passport Number</th>
            <th>Seat</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Passengers)
        {
            <tr>
                <td>@p.FullName</td>
                <td>@p.PassportNumber</td>
                <td>@p.SeatNumber</td>
            </tr>
        }
    </tbody>
</table>
