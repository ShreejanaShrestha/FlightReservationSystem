@model List<FlightReservationSystem.DTO.PassengerDto>

@{
    ViewData["Title"] = "Add Passenger Details";
}

<h2>Add Passenger Details</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-controller="Booking" asp-action="AddPassengerDetails" method="post">
    <div id="passenger-list">
        <div class="passenger-entry mb-3">
            <h5>Passenger 1</h5>
            <div class="form-group mb-2">
                <label class="form-label">Full Name</label>
                <input type="text" name="[0].FullName" class="form-control" required />
            </div>
            <div class="form-group mb-2">
                <label class="form-label">Passport Number (Optional)</label>
                <input type="text" name="[0].PassportNumber" class="form-control" />
            </div>
        </div>
    </div>

    <button type="button" id="add-passenger" class="btn btn-secondary mb-3">Add Another Passenger</button>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Proceed to Booking</button>
        <a asp-controller="Booking" asp-action="ReviewFlight" class="btn btn-secondary">Back to Review</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let passengerCount = 1;

        document.getElementById('add-passenger').addEventListener('click', function () {
            const passengerList = document.getElementById('passenger-list');
            const newPassenger = document.createElement('div');
            newPassenger.classList.add('passenger-entry', 'mb-3');
            newPassenger.innerHTML = `
                        <h5>Passenger ${passengerCount + 1}</h5>
                        <div class="form-group mb-2">
                            <label class="form-label">Full Name</label>
                            <input type="text" name="[${passengerCount}].FullName" class="form-control" required />
                        </div>
                        <div class="form-group mb-2">
                            <label class="form-label">Passport Number (Optional)</label>
                            <input type="text" name="[${passengerCount}].PassportNumber" class="form-control" />
                        </div>
                    `;
            passengerList.appendChild(newPassenger);
            passengerCount++;
        });
    </script>
}