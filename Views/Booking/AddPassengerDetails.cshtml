@* FlightReservationSystem/Views/Booking/AddPassengerDetails.cshtml *@
@model FlightReservationSystem.DTO.AddPassengerDetailsViewModel

@{
    ViewData["Title"] = "Add Passenger Details";
}

<style>
    .price-overview {
        background-color: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-top: 20px;
        border: 1px solid #dee2e6;
    }

        .price-overview h4 {
            margin-bottom: 15px;
        }

    .modal-body dl {
        margin-bottom: 0;
    }

    .passenger-entry {
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 15px;
    }

    .form-group .text-danger {
        font-size: 0.875em;
    }
</style>

<h2>Add Passenger Details</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form id="passengerForm" asp-controller="Booking" asp-action="AddPassengerDetails" method="post" class="pb-4">
    <input type="hidden" asp-for="FlightId" />
    <input type="hidden" asp-for="BasePrice" />

    <div id="passenger-list">
        @for (int i = 0; i < Model.Passengers.Count; i++)
        {
            <div class="passenger-entry mb-3">
                <h5>Passenger @(i + 1)</h5>
                <div class="form-group mb-2">
                    <label asp-for="Passengers[i].FullName" class="form-label"></label>
                    <input asp-for="Passengers[i].FullName" class="form-control" required />
                    <span asp-validation-for="Passengers[i].FullName" class="text-danger"></span>
                </div>
                <div class="form-group mb-2">
                    <label asp-for="Passengers[i].PassportNumber" class="form-label"></label>
                    <input asp-for="Passengers[i].PassportNumber" class="form-control" />
                    <span asp-validation-for="Passengers[i].PassportNumber" class="text-danger"></span>
                </div>
            </div>
        }
    </div>

    <button type="button" id="add-passenger" class="btn btn-secondary mb-3">Add Another Passenger</button>
    <button type="button" id="remove-passenger" class="btn btn-danger mb-3" style="display: @(Model.Passengers.Count > 1 ? "inline-block" : "none");">Remove Last Passenger</button>

    <!-- Price Overview Section -->
    <div class="price-overview">
        <h4>Price Overview</h4>
        <dl class="row">
            <dt class="col-sm-6">Base Price per Passenger</dt>
            <dd class="col-sm-6">$<span id="basePrice">@Model.BasePrice</span></dd>
            <dt class="col-sm-6">Number of Passengers</dt>
            <dd class="col-sm-6"><span id="passengerCount">@Model.Passengers.Count</span></dd>
            <dt class="col-sm-6">Total Price</dt>
            <dd class="col-sm-6">$<span id="totalPrice">@(Model.BasePrice * Model.Passengers.Count)</span></dd>
        </dl>
    </div>

    <div class="mt-3">
        <button type="button" class="btn btn-primary" onclick="showPriceConfirmation()">Review Price & Confirm</button>
        <a asp-controller="Booking" asp-action="ReviewFlight" class="btn btn-secondary">Back to Review</a>
    </div>
</form>

<!-- Modal for Price Confirmation -->
<div class="modal fade" id="priceConfirmationModal" tabindex="-1" role="dialog" aria-labelledby="priceConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="priceConfirmationModalLabel">Confirm Your Booking</h5>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h4>Final Bill</h4>
                <dl class="row">
                    <dt class="col-sm-6">Base Price per Passenger</dt>
                    <dd class="col-sm-6">$@Model.BasePrice</dd>
                    <dt class="col-sm-6">Number of Passengers</dt>
                    <dd class="col-sm-6"><span id="modalPassengerCount">@Model.Passengers.Count</span></dd>
                    <dt class="col-sm-6">Total Price</dt>
                    <dd class="col-sm-6">$<span id="modalTotalPrice">@(Model.BasePrice * Model.Passengers.Count)</span></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="confirmBooking()">Proceed to Booking</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let passengerCount = @Model.Passengers.Count;
        const basePrice = @Model.BasePrice;

        document.getElementById('add-passenger').addEventListener('click', function () {
            const passengerList = document.getElementById('passenger-list');
            const newPassenger = document.createElement('div');
            newPassenger.classList.add('passenger-entry', 'mb-3');
            newPassenger.innerHTML = `
                        <h5>Passenger ${passengerCount + 1}</h5>
                        <div class="form-group mb-2">
                            <label class="form-label">Full Name</label>
                            <input type="text" name="Passengers[${passengerCount}].FullName" class="form-control" required />
                            <span class="text-danger field-validation-valid" data-valmsg-for="Passengers[${passengerCount}].FullName" data-valmsg-replace="true"></span>
                        </div>
                        <div class="form-group mb-2">
                            <label class="form-label">Passport Number (Optional)</label>
                            <input type="text" name="Passengers[${passengerCount}].PassportNumber" class="form-control" />
                            <span class="text-danger field-validation-valid" data-valmsg-for="Passengers[${passengerCount}].PassportNumber" data-valmsg-replace="true"></span>
                        </div>
                    `;
            passengerList.appendChild(newPassenger);
            passengerCount++;
            updatePriceOverview();
            document.getElementById('remove-passenger').style.display = 'inline-block';
        });

        document.getElementById('remove-passenger').addEventListener('click', function () {
            if (passengerCount > 1) {
                const passengerList = document.getElementById('passenger-list');
                passengerList.removeChild(passengerList.lastElementChild);
                passengerCount--;
                updatePriceOverview();
                if (passengerCount === 1) {
                    document.getElementById('remove-passenger').style.display = 'none';
                }
            }
        });

        function updatePriceOverview() {
            const totalPrice = basePrice * passengerCount;
            document.getElementById('passengerCount').textContent = passengerCount;
            document.getElementById('totalPrice').textContent = totalPrice.toFixed(2);
            document.getElementById('modalPassengerCount').textContent = passengerCount;
            document.getElementById('modalTotalPrice').textContent = totalPrice.toFixed(2);
        }

        function showPriceConfirmation() {
            const form = document.getElementById('passengerForm');
            if (form.checkValidity()) {
                const bootstrapModal = new bootstrap.Modal(document.getElementById('priceConfirmationModal'));
                bootstrapModal.show();
            } else {
                form.reportValidity();
            }
        }

        function confirmBooking() {
            document.getElementById('passengerForm').submit();
        }

        document.addEventListener('DOMContentLoaded', function () {
            updatePriceOverview();
        });
    </script>
}