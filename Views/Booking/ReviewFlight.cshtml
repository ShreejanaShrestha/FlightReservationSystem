@model FlightReservationSystem.Models.Flight

@{
    ViewData["Title"] = "Review Flight";
}

<h2>Review Flight Details</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header">
        <h4>Flight #@Model.FlightNumber</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Flight Number</dt>
            <dd class="col-sm-9">@Model.FlightNumber</dd>

            <dt class="col-sm-3">Airline</dt>
            <dd class="col-sm-9">@Model.Airline.Name</dd>

            <dt class="col-sm-3">Departure Airport</dt>
            <dd class="col-sm-9">@Model.DepartureAirport.Name (@Model.DepartureAirport.Code)</dd>

            <dt class="col-sm-3">Arrival Airport</dt>
            <dd class="col-sm-9">@Model.ArrivalAirport.Name (@Model.ArrivalAirport.Code)</dd>

            <dt class="col-sm-3">Departure Time</dt>
            <dd class="col-sm-9">@Model.DepartureTime</dd>

            <dt class="col-sm-3">Arrival Time</dt>
            <dd class="col-sm-9">@Model.ArrivalTime</dd>

            <dt class="col-sm-3">Base Price</dt>
            <dd class="col-sm-9">$@Model.BasePrice</dd>

            <dt class="col-sm-3">Available Seats</dt>
            <dd class="col-sm-9">@Model.Seats.Count(s => !s.IsBooked)</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Booking" asp-action="AddPassengerDetails" class="btn btn-primary">Proceed to Passenger Details</a>
    <a asp-controller="Search" asp-action="Search" class="btn btn-secondary">Back to Search</a>
</div>